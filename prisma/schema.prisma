// Folio schema: library, reading, imports and curated reading paths.
// Later-phase models are added incrementally through migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  yearlyGoal Int?
  goalYear Int?
  emailVerified DateTime?
  image         String?
  // bcrypt hash, used by the Credentials provider (email/password sign-up)
  password      String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  userBooks       UserBook[]
  readingSessions ReadingSession[]
  customShelves   CustomShelf[]
  importJobs      ImportJob[]
  giftClaims GiftItem[] @relation("GiftClaims")
  giftContacts GiftContact[]
  readingPaths ReadingPath[]
  followedPaths ReadingPathFollow[]
}

// ---------- Book hierarchy ----------

model Work {
  id             String   @id @default(cuid())
  title          String
  // Denormalized primary author display name. The full Contributor /
  // AuthorWork relational model (multiple authors, translators, etc.) is
  // later-phase per the brief's §15.1 full schema — this is the minimal
  // field Phase 1's BookCard/Library/Chat screens need to show an author.
  authorName     String
  openLibraryId  String?  @unique
  wikidataId     String?
  originalLang   String   @default("en")
  description    String?
  genres         String[]
  themes         String[]
  // Similarity search input for Phase 2's recommendation engine.
  // Kept as a plain float array for now; migrate to pgvector's native
  // `vector` type via a raw-SQL migration once embeddings are populated.
  embedding      Float[]
  createdAt      DateTime @default(now())

  giftItems GiftItem[]
  pathEntries ReadingPathEntry[]
  translations Translation[]
  editions     Edition[]
}

model Translation {
  id       String @id @default(cuid())
  workId   String
  language String

  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  editions Edition[]

  @@index([workId])
}

model Edition {
  openLibraryId String? @unique
  editionTitle String?
  languages String[] @default([])
  translators String[] @default([])
  metadataUpdatedAt DateTime?
  id            String   @id @default(cuid())
  workId        String
  translationId String?
  publisher     String?
  year          Int?
  isbn13        String?  @unique
  isbn10        String?
  format        String // hardback | paperback | ebook | audiobook | large_print
  coverUrl      String?
  pageCount     Int?
  createdAt     DateTime @default(now())

  work        Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  translation Translation? @relation(fields: [translationId], references: [id])
  userBooks   UserBook[]

  @@index([workId])
}

// ---------- User library ----------

enum Shelf {
  reading_now
  read
  tbr
  owned_unread
  wishlist
  not_for_me
  dnf
  interested
  lent_out
  reference
}

model UserBook {
  id             String    @id @default(cuid())
  userId         String
  editionId      String
  shelf          Shelf
  priority       Int       @default(0)
  dateAdded      DateTime  @default(now())
  dateStarted    DateTime?
  dateFinished   DateTime?
  pageAbandoned  Int?
  rating         Float?
  privateNotes   String?
  formatOwned    String?
  purchaseSource String?
  importedReview String?
  customShelves  CustomShelf[]

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition         Edition          @relation(fields: [editionId], references: [id])
  readingSessions ReadingSession[]

  @@index([userId, shelf])
  @@unique([userId, editionId])
}

model CustomShelf {
  id String @id @default(cuid())
  userId String
  name String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  books UserBook[]
  @@unique([userId, name])
}

model ImportJob {
  id String @id @default(cuid())
  userId String
  status String @default("queued")
  rows Json
  total Int
  processed Int @default(0)
  imported Int @default(0)
  skipped Int @default(0)
  reviews ImportReview[]
  errors Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model ReadingSession {
  id         String    @id @default(cuid())
  userId     String
  userBookId String
  date       DateTime  @default(now())
  finished Boolean @default(false)
  requestId String? @unique
  createdAt DateTime @default(now())
  pageStart  Int
  pageEnd    Int
  timeStart  DateTime?
  timeEnd    DateTime?
  note       String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@index([userBookId])
}

model ImportReview {
  id String @id @default(cuid())
  jobId String
  rowIndex Int
  row Json
  candidateIds String[]
  status String @default("pending")
  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, rowIndex])
}

model ReadingPath {
  id String @id @default(cuid())
  userId String
  title String
  description String
  isPublic Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ReadingPathEntry[]
  followers ReadingPathFollow[]
  @@index([userId, updatedAt])
  @@index([isPublic, updatedAt])
}
model ReadingPathEntry {
  id String @id @default(cuid())
  pathId String
  workId String
  position Int
  note String @default("")
  path ReadingPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  @@unique([pathId, workId])
  @@unique([pathId, position])
  @@index([workId])
}
model ReadingPathFollow {
  userId String
  pathId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path ReadingPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  @@id([userId, pathId])
  @@index([pathId])
}

model GiftContact {
 shareToken String? @unique
 id String @id @default(cuid())
 userId String
 name String
 tasteNotes String @default("")
 budgetPence Int?
 occasions Json @default("[]")
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 giftItems GiftItem[]
 @@index([userId, name])
}
model GiftItem {
 claimedById String?
 claimedAt DateTime?
 claimVersion Int @default(0)
 claimedBy User? @relation("GiftClaims", fields: [claimedById], references: [id], onDelete: SetNull)
 id String @id @default(cuid())
 contactId String
 workId String
 status String @default("planned")
 priority String @default("might_like")
 pricePence Int?
 note String @default("")
 contact GiftContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
 work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
 @@unique([contactId, workId])
 @@index([workId])
}
