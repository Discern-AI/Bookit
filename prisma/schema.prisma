// Folio schema: library, reading, imports and curated reading paths.
// Later-phase models are added incrementally through migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  articleReports ArticleReport[]
  blogEnabled Boolean @default(false)
  blogVersion Int @default(0)
  articles Article[]
  authVersion Int @default(0)
  appeals ReviewAppeal[]
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  yearlyGoal Int?
  goalYear Int?
  emailVerified DateTime?
  image         String?
  // bcrypt hash, used by the Credentials provider (email/password sign-up)
  password      String?
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  userBooks       UserBook[]
  readingSessions ReadingSession[]
  customShelves   CustomShelf[]
  importJobs      ImportJob[]
  giftClaims GiftItem[] @relation("GiftClaims")
  giftContacts GiftContact[]
  readingPaths ReadingPath[]
  followedPaths ReadingPathFollow[]
  isModerator Boolean @default(false)
  reviewLikes ReviewLike[]
  reviewComments ReviewComment[]
  reviewReports ReviewReport[]
  readerFollowing ReaderFollow[] @relation("ReaderFollowing")
  readerFollowers ReaderFollow[] @relation("ReaderFollowers")
  username String? @unique
  publicName String @default("")
  bio String @default("")
  profilePublic Boolean @default(false)
  profileVersion Int @default(0)
  reviews BookReview[]
}

// ---------- Book hierarchy ----------

model Work {
  appeals ReviewAppeal[]
  id             String   @id @default(cuid())
  title          String
  // Denormalized primary author display name. The full Contributor /
  // AuthorWork relational model (multiple authors, translators, etc.) is
  // later-phase per the brief's §15.1 full schema — this is the minimal
  // field Phase 1's BookCard/Library/Chat screens need to show an author.
  authorName     String
  openLibraryId  String?  @unique
  wikidataId     String?
  originalLang   String   @default("en")
  description    String?
  genres         String[]
  themes         String[]
  // Similarity search input for Phase 2's recommendation engine.
  // Kept as a plain float array for now; migrate to pgvector's native
  // `vector` type via a raw-SQL migration once embeddings are populated.
  embedding      Float[]
  createdAt      DateTime @default(now())

  reviews BookReview[]
  giftItems GiftItem[]
  pathEntries ReadingPathEntry[]
  translations Translation[]
  editions     Edition[]
}

model Translation {
  id       String @id @default(cuid())
  workId   String
  language String

  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  editions Edition[]

  @@index([workId])
}

model Edition {
  openLibraryId String? @unique
  editionTitle String?
  languages String[] @default([])
  translators String[] @default([])
  metadataUpdatedAt DateTime?
  id            String   @id @default(cuid())
  workId        String
  translationId String?
  publisher     String?
  year          Int?
  isbn13        String?  @unique
  isbn10        String?
  format        String // hardback | paperback | ebook | audiobook | large_print
  coverUrl      String?
  pageCount     Int?
  createdAt     DateTime @default(now())

  work        Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  translation Translation? @relation(fields: [translationId], references: [id])
  userBooks   UserBook[]

  @@index([workId])
}

// ---------- User library ----------

enum Shelf {
  reading_now
  read
  tbr
  owned_unread
  wishlist
  not_for_me
  dnf
  interested
  lent_out
  reference
}

model UserBook {
  readingCycles ReadingCycle[]
  id             String    @id @default(cuid())
  userId         String
  editionId      String
  shelf          Shelf
  priority       Int       @default(0)
  dateAdded      DateTime  @default(now())
  dateStarted    DateTime?
  dateFinished   DateTime?
  pageAbandoned  Int?
  rating         Float?
  privateNotes   String?
  formatOwned    String?
  purchaseSource String?
  importedReview String?
  customShelves  CustomShelf[]

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition         Edition          @relation(fields: [editionId], references: [id])
  readingSessions ReadingSession[]

  @@index([userId, shelf])
  @@unique([userId, editionId])
}

model CustomShelf {
    isPublic Boolean @default(false)
    shareVersion Int @default(0)
  id String @id @default(cuid())
  userId String
  name String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  books UserBook[]
  @@unique([userId, name])
}

model ImportJob {
  id String @id @default(cuid())
  userId String
  status String @default("queued")
  rows Json
  total Int
  processed Int @default(0)
  imported Int @default(0)
  skipped Int @default(0)
  reviews ImportReview[]
  errors Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model ReadingSession {
  cycleId String?
  cycle ReadingCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  version Int @default(0)
  deletedAt DateTime?
  id         String    @id @default(cuid())
  userId     String
  userBookId String
  date       DateTime  @default(now())
  finished Boolean @default(false)
  requestId String? @unique
  createdAt DateTime @default(now())
  pageStart  Int
  pageEnd    Int
  timeStart  DateTime?
  timeEnd    DateTime?
  note       String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@index([userBookId])
}

model ImportReview {
  id String @id @default(cuid())
  jobId String
  rowIndex Int
  row Json
  candidateIds String[]
  status String @default("pending")
  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, rowIndex])
}

model ReadingPath {
  id String @id @default(cuid())
  userId String
  title String
  description String
  isPublic Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ReadingPathEntry[]
  followers ReadingPathFollow[]
  @@index([userId, updatedAt])
  @@index([isPublic, updatedAt])
}
model ReadingPathEntry {
  id String @id @default(cuid())
  pathId String
  workId String
  position Int
  note String @default("")
  path ReadingPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  @@unique([pathId, workId])
  @@unique([pathId, position])
  @@index([workId])
}
model ReadingPathFollow {
  userId String
  pathId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path ReadingPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  @@id([userId, pathId])
  @@index([pathId])
}

model GiftContact {
 shareToken String? @unique
 id String @id @default(cuid())
 userId String
 name String
 tasteNotes String @default("")
 budgetPence Int?
 occasions Json @default("[]")
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 giftItems GiftItem[]
 @@index([userId, name])
}
model GiftItem {
 claimedById String?
 claimedAt DateTime?
 claimVersion Int @default(0)
 claimedBy User? @relation("GiftClaims", fields: [claimedById], references: [id], onDelete: SetNull)
 id String @id @default(cuid())
 contactId String
 workId String
 status String @default("planned")
 priority String @default("might_like")
 pricePence Int?
 note String @default("")
 contact GiftContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
 work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
 @@unique([contactId, workId])
 @@index([workId])
}

model BookReview {
 moderationVersion Int @default(0)
 // Null frees the unique active slot while retaining moderation references.
 active Boolean? @default(true)
 deletedAt DateTime?
 isHidden Boolean @default(false)
 likes ReviewLike[]
 comments ReviewComment[]
 reports ReviewReport[]
 id String @id @default(cuid())
 userId String
 workId String
 body String
 rating Int?
 isPublic Boolean @default(false)
 version Int @default(1)
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
 @@unique([userId, workId, active])
 @@index([userId, workId, version])
 @@index([isPublic, updatedAt])
}

model ReaderFollow {
 followerId String
 readerId String
 createdAt DateTime @default(now())
 follower User @relation("ReaderFollowing", fields: [followerId], references: [id], onDelete: Cascade)
 reader User @relation("ReaderFollowers", fields: [readerId], references: [id], onDelete: Cascade)
 @@id([followerId, readerId])
 @@index([readerId])
 @@index([followerId, createdAt])
}

model ReviewLike {
 userId String
 reviewId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 review BookReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
 @@id([userId, reviewId])
 @@index([reviewId])
}
model ReviewComment {
 id String @id
 userId String
 reviewId String
 body String
 isHidden Boolean @default(false)
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 review BookReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
 reports ReviewReport[]
 @@index([reviewId, createdAt])
 @@index([userId, createdAt])
}
model ReviewReport {
 snapshot String
 resolvedById String?
 id String @id @default(cuid())
 reporterId String
 reviewId String
 commentId String?
 targetKey String
 reason String
 details String
 status String @default("pending")
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
 review BookReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
 comment ReviewComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
 @@unique([reporterId, targetKey])
 @@index([status, createdAt])
}

model ReviewAppeal {
 id String @id @default(cuid())
 userId String
 workId String
 moderationVersion Int
 reason String
 snapshot String
 status String @default("pending")
 response String @default("")
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 resolvedById String?
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
 @@unique([userId, workId, moderationVersion])
 @@index([status, createdAt])
 @@index([userId, createdAt])
}

model Article {
  sourceReviewId String?
  sourceReviewVersion Int?
  appeals ArticleAppeal[]
  isHidden Boolean @default(false)
  moderationVersion Int @default(0)
  reports ArticleReport[]
  images ArticleImage[]
 id String @id
 userId String
 title String
 excerpt String @default("")
 content Json
 version Int @default(1)
 isPublic Boolean @default(false)
 publishedTitle String?
 publishedExcerpt String?
 publishedContent Json?
 publishedVersion Int?
 publishedAt DateTime?
 publishedReadMinutes Int @default(1)
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId, updatedAt])
 @@index([isPublic, publishedAt])
 @@unique([userId,sourceReviewId,sourceReviewVersion])
}

model ArticleImage {
  id String @id @default(uuid())
  articleId String
  data Bytes
  createdAt DateTime @default(now())
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@index([articleId])
}

model ArticleReport {
 id String @id @default(cuid())
 articleId String
 reporterId String
 publishedVersion Int
 title String
 snapshot Json
 imageIds String[]
 reason String
 details String
 status String @default("pending")
 decisionVersion Int?
 note String @default("")
 resolvedById String?
 resolvedAt DateTime?
 restoreNote String @default("")
 restoredById String?
 restoredAt DateTime?
 createdAt DateTime @default(now())
 article Article @relation(fields:[articleId],references:[id],onDelete:Cascade)
 reporter User @relation(fields:[reporterId],references:[id],onDelete:Cascade)
 @@unique([articleId,reporterId,publishedVersion])
 @@index([status,createdAt])
}

model ArticleAppeal {
 id String @id @default(cuid())
 articleId String
 moderationVersion Int
 reason String
 title String
 snapshot Json
 imageIds String[]
 status String @default("pending")
 response String @default("")
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 resolvedById String?
 article Article @relation(fields:[articleId],references:[id],onDelete:Cascade)
 @@unique([articleId,moderationVersion])
 @@index([status,createdAt])
}

model ReadingCycle {
 cancelledAt DateTime?
 id String @id @default(cuid())
 userBookId String
 number Int
 isCurrent Boolean @default(true)
 dateStarted DateTime?
 dateFinished DateTime?
 version Int @default(0)
 requestId String? @unique
 userBook UserBook @relation(fields:[userBookId],references:[id],onDelete:Cascade)
 sessions ReadingSession[]
 @@unique([userBookId,number])
}
