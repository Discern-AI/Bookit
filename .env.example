DATABASE_URL="postgresql://folio:folio@localhost:5432/folio"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
ANTHROPIC_API_KEY=""
OPEN_LIBRARY_BASE="https://openlibrary.org"

AUTH_TRUST_HOST=true
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Account mail: an HTTPS service accepting {to, subject, text}; bearer secret.
FOLIO_MAIL_WEBHOOK=""
FOLIO_MAIL_SECRET=""
# Local testing only, with a localhost NEXTAUTH_URL: writes ignored .local/mail/*.json
FOLIO_MAIL_MODE=""

# Dedicated 32-byte base64 key for personal context (never reuse the auth secret).
FOLIO_CONTEXT_KEY=""
# Alternative: path to a file containing that base64 key, e.g. .local/context-encryption.key
FOLIO_CONTEXT_KEY_FILE=""
